# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Experiment artifacts that are too large or not reproducible by inspection.
# Evaluation logs (evaluations.npz) and config.json stay tracked on purpose:
# they are small and they are the actual evidence behind the plots.
results/**/*.zip
results/**/*.pkl
results/**/monitor/
models/
checkpoints/

# Training logs
logs/
runs/
run_logs/
wandb/
*.monitor.csv
events.out.tfevents.*

# Rendered videos. The mp4 is large and stays out; the small GIF the README
# embeds is tracked on purpose, since a linked GIF is what renders inline.
*.mp4

# Local assistant context, not part of the project
CLAUDE.md

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
